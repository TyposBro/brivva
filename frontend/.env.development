# Local dev env — Vite picks this up automatically in dev mode.
# Overrides the (currently inverted) defaults in src/orchestration/bootstrap.ts.
#
# Run `./scripts/dev-all.sh` from repo root to boot server-rs + workers + vite
# in one shot with matching URLs.

# Workers API (Hono routes — D1 reads, OAuth, voice clone, etc.)
VITE_API_URL=http://localhost:8787

# Media engine (server-rs — WebSocket control/audio + WebRTC video signaling).
# bootstrap.ts rewrites http→ws automatically.
VITE_MEDIA_URL=http://localhost:3000

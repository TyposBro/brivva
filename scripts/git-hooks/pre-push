#!/usr/bin/env bash
#
# pre-push — medium-cost checks before code leaves the laptop (<30s target).
#
# Runs on every `git push`. Skip with --no-verify only for emergency fixes
# when CI is already broken on main.
#
# Checks:
#   1. Contract drift — Rust bindings match OpenAPI schema
#   2. TypeScript typecheck for workers + frontend
#   3. `cargo check` for server-rs
#
# Deliberately NOT running:
#   - Unit tests: CI handles them in parallel, no need to double-pay the wait
#   - E2E smoke: docker-compose stack, too slow for pre-push
#   - Full builds: CI builds on merge, local builds on demand

set -euo pipefail

RED=$'\033[0;31m'
YELLOW=$'\033[0;33m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

fail() {
  echo "${RED}pre-push FAIL:${NC} $1"
  exit 1
}

ok() {
  echo "${GREEN}pre-push OK:${NC} $1"
}

warn() {
  echo "${YELLOW}pre-push WARN:${NC} $1"
}

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# ── 1. Contract drift — same gate as CI ──────────────────────
if [ -f contracts/package.json ] && [ -f workers/package.json ]; then
  echo "checking contract drift..."
  # Regenerate Rust bindings from the source OpenAPI schema.
  # If git diff is non-empty afterward, contracts are out of sync.
  if bun run contracts:gen-rust >/dev/null 2>&1; then
    if ! git diff --quiet server-rs/src/core/contracts/ 2>/dev/null; then
      git diff --stat server-rs/src/core/contracts/
      # Reset so we don't dirty the working tree.
      git checkout -- server-rs/src/core/contracts/ 2>/dev/null || true
      fail "contracts out of sync. Run \`bun run contracts:gen-rust\` and commit the result."
    fi
    ok "contracts in sync"
  else
    warn "contracts:gen-rust failed to run — skipping drift check"
  fi
fi

# ── 2. Workers typecheck ─────────────────────────────────────
if [ -f workers/package.json ]; then
  echo "typechecking workers..."
  (cd workers && bun run typecheck) || fail "workers typecheck failed"
  ok "workers typecheck clean"
fi

# ── 3. Frontend typecheck ────────────────────────────────────
if [ -f frontend/package.json ]; then
  echo "typechecking frontend..."
  (cd frontend && bun run typecheck) || fail "frontend typecheck failed"
  ok "frontend typecheck clean"
fi

# ── 4. server-rs cargo check ─────────────────────────────────
if [ -f server-rs/Cargo.toml ]; then
  echo "cargo check server-rs..."
  (cd server-rs && cargo check --all-targets --quiet) || fail "server-rs cargo check failed"
  ok "server-rs cargo check clean"
fi

ok "pre-push passed"
exit 0

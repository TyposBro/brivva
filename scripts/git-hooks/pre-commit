#!/usr/bin/env bash
#
# pre-commit — fast structural checks (<5s target).
#
# Runs on every `git commit`. Skip with --no-verify if you know what
# you're doing, but understand which guardrail you're ignoring.
#
# Checks:
#   0. No commits during 10:00–18:00 Korea time (KST / Asia/Seoul)
#   1. No committed secrets (AWS keys, private keys, Stripe/OpenAI/Anthropic keys)
#   2. No .env* files (except .env.example)
#   3. No terraform state files
#   4. Rust formatting (if .rs files staged)
#   5. Per-subproject layer checks (only if that subproject changed)
#
# Unit tests + full typecheck live in pre-push. Full CI runs on push anyway.

set -euo pipefail

RED=$'\033[0;31m'
YELLOW=$'\033[0;33m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

fail() {
  echo "${RED}pre-commit FAIL:${NC} $1"
  exit 1
}

warn() {
  echo "${YELLOW}pre-commit WARN:${NC} $1"
}

ok() {
  echo "${GREEN}pre-commit OK:${NC} $1"
}

# ── 0. Commit quiet hours (Korea time) ──────────────────────
# No commits during office hours. Use --no-verify only for an explicit
# same-turn emergency override; otherwise stage/test now, commit later.
KST_HOUR=$(TZ=Asia/Seoul date +%H)
KST_TIME=$(TZ=Asia/Seoul date '+%Y-%m-%d %H:%M:%S %Z')
if [ "$KST_HOUR" -ge 10 ] && [ "$KST_HOUR" -lt 18 ]; then
  fail "commits are blocked from 10:00 to 18:00 KST (now: $KST_TIME). Stage/test now; commit after 18:00 KST."
fi
ok "commit window allowed (KST now: $KST_TIME)"

# List of staged files (added/modified, not deleted).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
STAGED_COUNT=$(echo -n "$STAGED" | grep -c '^' || true)

if [ "$STAGED_COUNT" -eq 0 ]; then
  ok "nothing staged"
  exit 0
fi

# ── 1. Secrets scan ──────────────────────────────────────────
# Patterns with low false-positive rate. Extend with care.
SECRET_PATTERNS='AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----|sk-ant-[A-Za-z0-9_-]{90,}|sk-[A-Za-z0-9]{32,}|sk_live_[0-9a-zA-Z]{24,}|xoxb-[0-9]{11,}-[0-9]{11,}-[A-Za-z0-9]{24,}'

SECRET_HITS=""
for f in $STAGED; do
  # Skip lockfiles + binary-ish files that trip false positives.
  case "$f" in
    *.lock|*bun.lock|*Cargo.lock|*package-lock.json|*yarn.lock) continue ;;
    *.tfstate|*.tfstate.backup) continue ;;  # handled by step 3
    *.md|*.txt) ;;  # scan docs too — README might accidentally paste a key
  esac
  if git show ":0:$f" 2>/dev/null | grep -qE "$SECRET_PATTERNS"; then
    SECRET_HITS="$SECRET_HITS\n  - $f"
  fi
done

if [ -n "$SECRET_HITS" ]; then
  fail "possible secret material in staged files:$SECRET_HITS\nReview the diff. If a false positive, use --no-verify AND explain in commit body."
fi

# ── 2. No .env files (except examples + Vite dev template) ──
# .env.development is Vite's convention for committed dev-mode defaults
# (only localhost URLs, no secrets). .env.production is where the real
# prod URLs live and is already committed — Vite loads it at build time.
# Keep blocking the wide-open .env / .env.local though.
ENV_HITS=$(echo "$STAGED" | grep -E '(^|/)\.env($|\.)' | grep -vE '\.env\.example$|\.env\.sample$|\.env\.template$|\.env\.development$|\.env\.production$' || true)

if [ -n "$ENV_HITS" ]; then
  fail "staged .env file(s) — never commit these:\n$ENV_HITS"
fi

# ── 3. No terraform state ────────────────────────────────────
TFSTATE_HITS=$(echo "$STAGED" | grep -E '\.tfstate(\.backup)?$' || true)

if [ -n "$TFSTATE_HITS" ]; then
  fail "staged terraform state file(s):\n$TFSTATE_HITS\nState belongs in S3 backend. See docs/terraform-state-migration-plan.md."
fi

# ── 4. Rust formatting (staged files only) ──────────────────
# Check only files actually in the commit to avoid blocking on an
# unrelated collaborator's WIP elsewhere in the crate.
STAGED_RS=$(echo "$STAGED" | grep -E '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
  FMT_VIOLATIONS=""
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if ! rustfmt --check --edition 2024 "$f" >/dev/null 2>&1; then
      FMT_VIOLATIONS="$FMT_VIOLATIONS\n  - $f"
    fi
  done <<< "$STAGED_RS"

  if [ -n "$FMT_VIOLATIONS" ]; then
    fail "rustfmt violations in staged files:$FMT_VIOLATIONS\nRun \`rustfmt --edition 2024 <file>\` (or \`cargo fmt\`) and restage."
  fi
  ok "rustfmt clean (staged files)"
fi

# ── 5. Layer checks per subproject ───────────────────────────
if echo "$STAGED" | grep -q '^server-rs/'; then
  if [ -f server-rs/scripts/check-layers.sh ]; then
    (cd server-rs && ./scripts/check-layers.sh) || fail "server-rs layer check failed (see §1.2 in claude.md)"
    ok "server-rs layer check passed"
  fi
fi

if echo "$STAGED" | grep -q '^workers/src/'; then
  if [ -f workers/scripts/check-layers.ts ]; then
    (cd workers && bun run check:layers) || fail "workers layer check failed (see §1.2 in claude.md)"
    ok "workers layer check passed"
  fi
fi

if echo "$STAGED" | grep -q '^frontend/src/'; then
  if [ -f frontend/scripts/check-layers.ts ]; then
    (cd frontend && bun run check:layers) || fail "frontend layer check failed (see §1.2 in claude.md)"
    ok "frontend layer check passed"
  fi
fi

ok "pre-commit passed"
exit 0

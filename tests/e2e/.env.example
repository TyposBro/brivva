# Credentials for the real-stack Playwright e2e at
# frontend/e2e/full-stack-live.e2e.ts
#
# Copy to tests/e2e/.env (gitignored) and fill in your values.
# Each block is OPTIONAL: only the blocks for destinations you pass via
# `./scripts/test-e2e-real.sh --grip|--youtube|--rtmp|--rtmp2 <lang>`
# are required.
#
# See `./scripts/test-e2e-real.sh --help` for the flag matrix and
# tests/e2e/README.md for combination tables.
#
# RTMP creds are ephemeral — Grip keys expire after a single broadcast,
# YouTube keys are regenerable per event. Repopulate before each run.

# ── Grip (--grip <lang>) ──────────────────────────────────
# Create a live event in Grip Seller Center → copy the RTMPS URL +
# stream key. Required only if you pass `--grip`.
GRIP_RTMP_URL=rtmps://YOUR-GRIP-INGEST.global-contribute.live-video.net:443/app
GRIP_RTMP_KEY=sk_YOUR_GRIP_STREAM_KEY

# ── YouTube via Custom RTMP (--youtube <lang>) ────────────
# YouTube doesn't expose a paste-creds flow in Brivva (its OAuth path
# is skipped by the e2e). Create a "Stream now" live event on YouTube
# Studio, copy the Stream URL + Stream key. Required only if `--youtube`.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_RTMP_KEY=YOUR_YT_STREAM_KEY

# ── Custom RTMP #2 (--rtmp <lang>) ────────────────────────
# A second Custom-RTMP destination. Use any RTMP/RTMPS endpoint. Set
# only if `--rtmp` is passed (max-pressure runs need ≥3 destinations).
RTMP_URL=
RTMP_KEY=

# ── Custom RTMP #3 (--rtmp2 <lang>) ───────────────────────
# A third Custom-RTMP destination. Used only when `--rtmp2` is passed
# (max-pressure: 1 source + 3 translations + 1 passthrough = 4 dests).
RTMP2_URL=
RTMP2_KEY=

# ── Optional overrides ────────────────────────────────────
# Leave commented to use the dev-stack defaults.
# BRIVVA_DEV_FRONTEND_URL=http://localhost:5173
# BRIVVA_DEV_WORKERS_URL=http://localhost:8787
